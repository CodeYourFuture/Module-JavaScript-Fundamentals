#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

# Do not override an explicit commit message.
if [[ -s "$msg_file" ]]; then
  exit 0
fi

files=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [[ -z "$files" ]]; then
  exit 0
fi

# Prefer a conventional-commit style subject.
type="chore"
for path in $files; do
  lower=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
  if [[ "$lower" == *"fix"* || "$lower" == *"bug"* || "$lower" == *"error"* || "$lower" == *"debug"* ]]; then
    type="fix"
    break
  elif [[ "$lower" == *"test"* || "$lower" == *"spec"* ]]; then
    type="test"
  elif [[ "$lower" == *"readme"* || "$lower" == *"doc"* || "$lower" == *"guide"* ]]; then
    type="docs"
  elif [[ "$lower" == *"feature"* || "$lower" == *"add"* || "$lower" == *"new"* ]]; then
    type="feat"
  fi
done

first_path=$(printf '%s\n' "$files" | head -n 1)
base_name=$(basename "$first_path")
clean_name=${base_name%.*}
if [[ -z "$clean_name" || "$clean_name" == "." ]]; then
  clean_name="project"
fi

if [[ $(printf '%s\n' "$files" | wc -l | tr -d ' ') -gt 1 ]]; then
  summary="update project files"
else
  summary="update ${clean_name}"
fi

printf '%s: %s\n' "$type" "$summary" > "$msg_file"
