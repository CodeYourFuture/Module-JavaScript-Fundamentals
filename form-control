<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="Order form for CodeYourFuture t-shirt — confirm name & email, choose colour and size. HTML-only, accessible, validated." />
  <title>CYF T-shirt Order — Form Controls</title>
</head>
<body>
  <header>
    <h1>CodeYourFuture — T-shirt Order</h1>
    <p>We already have your address & payment details — please confirm identity and choose a colour & size. All fields are required.</p>
  </header>

  <main>
    <form id="tshirt-order" aria-labelledby="order-title">
      <h2 id="order-title">Order form</h2>

      <p id="instructions">Fill in your name and email, then pick one colour and one size. Submitting the form will use built-in browser validation.</p>

      <!-- Name -->
      <div>
        <label for="full-name">Full name</label><br />
        <input
          id="full-name"
          name="fullName"
          type="text"
          required
          minlength="2"
          aria-describedby="name-desc"
        />
        <div id="name-desc">Enter your full name (at least 2 characters).</div>
      </div>

      <!-- Email -->
      <div>
        <label for="email">Email address</label><br />
        <input
          id="email"
          name="email"
          type="email"
          required
          aria-describedby="email-desc"
        />
        <div id="email-desc">We will use this to send an order confirmation.</div>
      </div>

      <!-- Colour (radio group) -->
      <fieldset>
        <legend>Choose a colour</legend>
        <div>
          <input type="radio" id="colour-black" name="colour" value="black" required>
          <label for="colour-black">Black</label>
        </div>
        <div>
          <input type="radio" id="colour-white" name="colour" value="white">
          <label for="colour-white">White</label>
        </div>
        <div>
          <input type="radio" id="colour-navy" name="colour" value="navy">
          <label for="colour-navy">Navy</label>
        </div>
      </fieldset>

      <!-- Size (select) -->
      <div>
        <label for="size">Choose a size</label><br />
        <select id="size" name="size" required aria-describedby="size-desc">
          <option value="" disabled selected>— Select size —</option>
          <option value="XS">XS</option>
          <option value="S">S</option>
          <option value="M">M</option>
          <option value="L">L</option>
          <option value="XL">XL</option>
          <option value="XXL">XXL</option>
        </select>
        <div id="size-desc">Choose one size from XS to XXL.</div>
      </div>

      <!-- Submit -->
      <div>
        <button type="submit">Confirm order</button>
      </div>
    </form>
  </main>

  <footer>
    <p>&copy; 2025 CodeYourFuture — Form Controls exercise</p>
  </footer>
</body>
</html>
